FROM ubuntu:18.04 as ubuntu1804
ARG TARGETARCH
ARG OS_RELEASE=bionic
ARG DIR=ubuntu-18.04-${TARGETARCH}-debs
ARG PKGS=".common[],.debs[]"
ARG BUILD_TOOLS="apt-transport-https software-properties-common ca-certificates curl wget gnupg dpkg-dev genisoimage"
ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends ca-certificates apt-transport-https curl wget gnupg \
 && sed -i 's|http://archive.ubuntu.com/ubuntu/|https://mirrors.huaweicloud.com/ubuntu/|g' /etc/apt/sources.list \
 && sed -i 's|http://security.ubuntu.com/ubuntu/|https://mirrors.huaweicloud.com/ubuntu/|g' /etc/apt/sources.list \
 && apt-get update -qq \
 && apt-get install -y --no-install-recommends software-properties-common dpkg-dev genisoimage \
 && add-apt-repository ppa:gluster/glusterfs-7 -y || true \
 && curl -fsSL https://mirrors.huaweicloud.com/docker-ce/linux/ubuntu/gpg | apt-key add - \
 && echo "deb [arch=${TARGETARCH}] https://mirrors.huaweicloud.com/docker-ce/linux/ubuntu ${OS_RELEASE} stable" > /etc/apt/sources.list.d/docker.list \
 && apt-get update -qq

WORKDIR /package
COPY packages.yaml .

COPY --from=mikefarah/yq:4.11.1 /usr/bin/yq /usr/bin/yq
# Expand the manifest into the full dependency closure (Depends + PreDepends) before
# resolving download URIs. apt-get install --print-uris otherwise prunes any dependency
# that is already installed in the build container, so the offline ISO silently lacks it
# and a minimal target node fails (e.g. nftables -> libnftables1 -> libjansson4 (>= 2.14)
# was dropped from the v4.0.8 ISO). Naming every closure package explicitly makes --reinstall
# re-fetch all of them regardless of the build container's install state.
RUN yq eval "${PKGS}" packages.yaml | sort -u > /tmp/want.list \
    && apt-cache depends --recurse --no-recommends --no-suggests --no-conflicts --no-breaks --no-replaces --no-enhances $(cat /tmp/want.list) \
       | grep -E '^[a-zA-Z0-9]' | sort -u > /tmp/closure.list \
    && while read p; do apt-cache policy "$p" | grep -qE 'Candidate: [0-9]' && echo "$p"; done < /tmp/closure.list > packages.list \
    && apt-get install --yes --reinstall --print-uris $(cat packages.list) | awk -F "'" '{print $2}' | grep -v '^$' | sort -u > packages.urls

RUN mkdir -p ${DIR} \
    && ( ok=0; i=1; \
         while [ $i -le 5 ]; do \
           if wget -nv -c -x -P ${DIR} --tries=3 --waitretry=10 --timeout=60 --retry-connrefused -i packages.urls; then ok=1; break; fi; \
           echo "### wget attempt $i failed; retrying in $((i * 10))s"; \
           sleep $((i * 10)); \
           i=$((i + 1)); \
         done; \
         [ "$ok" = "1" ] ) \
    && cd ${DIR} \
    && dpkg-scanpackages ./ /dev/null | gzip -9c > ./Packages.gz

RUN genisoimage -r -o ${DIR}.iso ${DIR}

FROM scratch
COPY --from=ubuntu1804 /package/*.iso /
