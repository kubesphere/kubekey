FROM debian:12 as debian12
ARG TARGETARCH
ARG OS_RELEASE=bookworm
ARG OS_VERSION=12
ARG DIR=debian-12-${TARGETARCH}-debs
ARG PKGS=".common[],.debs[]"
ARG BUILD_TOOLS="apt-transport-https software-properties-common ca-certificates curl wget gnupg dpkg-dev genisoimage dirmngr"
ENV DEBIAN_FRONTEND=noninteractive

RUN install -m 0755 -d /etc/apt/keyrings \
    && ARCH=$(dpkg --print-architecture) \
    && apt update -qq \
    && apt install -y --no-install-recommends $BUILD_TOOLS \
    && if [ "$TARGETARCH" = "amd64" ]; then \
        curl -fsSL https://download.gluster.org/pub/gluster/glusterfs/11/rsa.pub | gpg --dearmor -o /etc/apt/keyrings/glusterfs-archive-keyring.gpg ; \
        echo "deb [arch=$TARGETARCH signed-by=/etc/apt/keyrings/glusterfs-archive-keyring.gpg] https://download.gluster.org/pub/gluster/glusterfs/11/LATEST/Debian/${OS_VERSION}/amd64/apt ${OS_RELEASE} main" > /etc/apt/sources.list.d/gluster.list ; \
       fi \
    && curl -fsSL "https://download.docker.com/linux/debian/gpg" | gpg --dearmor -o /etc/apt/keyrings/docker-archive-keyring.gpg \
    && echo "deb [arch=$TARGETARCH signed-by=/etc/apt/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian ${OS_RELEASE} stable" > /etc/apt/sources.list.d/docker.list \
    && apt update -qq \
    && apt upgrade -y -qq

WORKDIR /package
COPY packages.yaml .

COPY --from=mikefarah/yq:4.30.8 /usr/bin/yq /usr/bin/yq
# Resolve every member of the manifest's full dependency closure (Depends + PreDepends) to
# its own download URI. Use `apt-get download` rather than `apt-get install --print-uris`:
# the latter runs the dependency solver, which has two failure modes here.
#   1. It prunes any dependency already installed in the build container, so the offline ISO
#      stays incomplete (e.g. nftables -> libnftables1 -> libjansson4 (>= 2.14) was dropped
#      from the v4.0.8 ISO).
#   2. It aborts with "Unable to correct problems, you have held broken packages" as soon as
#      `apt-cache depends --recurse` has expanded both branches of an alternative dependency
#      whose members Conflicts with each other - both then exist as explicit install targets.
#      Real case: libqt5gui5 vs libqt5gui5-gles and mew-bin vs mew-beta-bin, which made every
#      Debian/Ubuntu ISO resolve to zero packages.
# `apt-get download` skips the solver altogether: every named package maps to its candidate
# URI whatever its install state, and mutually conflicting names are accepted. Carrying both
# branches of an alternative in the offline repository is harmless - apt on the target node
# still installs only one of them.
RUN yq eval "${PKGS}" packages.yaml | sort -u > /tmp/want.list \
    && apt-cache depends --recurse --no-recommends --no-suggests --no-conflicts --no-breaks --no-replaces --no-enhances $(cat /tmp/want.list) \
       | grep -E '^[a-zA-Z0-9]' | sort -u > /tmp/closure.list \
    && while read p; do apt-cache policy "$p" | grep -qE 'Candidate: [0-9]' && echo "$p"; done < /tmp/closure.list > packages.list \
    && apt-get download --print-uris $(cat packages.list) | awk -F "'" '{print $2}' | grep -v '^$' | sort -u > packages.urls \
    && { [ -s packages.urls ] || { echo "ERROR: packages.urls is empty, no download URIs were resolved"; exit 1; }; }

RUN cat  packages.urls

RUN mkdir -p ${DIR} \
    && ( ok=0; i=1; \
         while [ $i -le 5 ]; do \
           if wget -nv -c -x -P ${DIR} --tries=3 --waitretry=10 --timeout=60 --retry-connrefused -i packages.urls; then ok=1; break; fi; \
           echo "### wget attempt $i failed; retrying in $((i * 10))s"; \
           sleep $((i * 10)); \
           i=$((i + 1)); \
         done; \
         [ "$ok" = "1" ] ) \
    && cd ${DIR} \
    && dpkg-scanpackages ./ /dev/null | gzip -9c > ./Packages.gz

RUN genisoimage -r -o ${DIR}.iso ${DIR}

FROM scratch
COPY --from=debian12 /package/*.iso /
