FROM rockylinux:9 as rocky9

ARG TARGETARCH
ARG DIR=rocky-9-${TARGETARCH}-rpms
ARG PKGS=".common[],.rpms[]"
ARG BUILD_TOOLS="createrepo_c genisoimage dnf-plugins-core"

ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

RUN rm -f /etc/yum.repos.d/*.repo \
    && if [ "$TARGETARCH" = "amd64" ]; then \
       BASEOS="https://dl.rockylinux.org/pub/rocky/9/BaseOS/x86_64/os/"; \
       APPSTREAM="https://dl.rockylinux.org/pub/rocky/9/AppStream/x86_64/os/"; \
    else \
       BASEOS="https://dl.rockylinux.org/pub/rocky/9/BaseOS/aarch64/os/"; \
       APPSTREAM="https://dl.rockylinux.org/pub/rocky/9/AppStream/aarch64/os/"; \
    fi \
    && echo "[BaseOS]" > /etc/yum.repos.d/rocky9.repo \
    && echo "name=Rocky Linux 9 BaseOS" >> /etc/yum.repos.d/rocky9.repo \
    && echo "baseurl=$BASEOS" >> /etc/yum.repos.d/rocky9.repo \
    && echo "enabled=1" >> /etc/yum.repos.d/rocky9.repo \
    && echo "gpgcheck=0" >> /etc/yum.repos.d/rocky9.repo \
    && echo "[AppStream]" >> /etc/yum.repos.d/rocky9.repo \
    && echo "name=Rocky Linux 9 AppStream" >> /etc/yum.repos.d/rocky9.repo \
    && echo "baseurl=$APPSTREAM" >> /etc/yum.repos.d/rocky9.repo \
    && echo "enabled=1" >> /etc/yum.repos.d/rocky9.repo \
    && echo "gpgcheck=0" >> /etc/yum.repos.d/rocky9.repo \
    && dnf --disablerepo="*" --enablerepo="BaseOS,AppStream" clean all \
    && dnf --disablerepo="*" --enablerepo="BaseOS,AppStream" makecache

RUN dnf install -y --setopt=tsflags=nodocs --disablerepo="*" --enablerepo="BaseOS,AppStream" $BUILD_TOOLS \
    && dnf clean all

WORKDIR /package

COPY packages.yaml .
COPY --from=mikefarah/yq:4.11.1 /usr/bin/yq /usr/bin/yq

RUN mkdir -p ${DIR} \
    && yq eval "${PKGS}" packages.yaml | while read pkg; do \
         if [ -n "$pkg" ]; then \
             echo "Downloading $pkg..."; \
             dnf install -y --downloadonly --downloaddir=${DIR} --disablerepo="*" --enablerepo="BaseOS,AppStream" $pkg || echo "not found: $pkg"; \
         fi; \
    done

RUN createrepo_c ${DIR} \
    && genisoimage -r -o ${DIR}.iso ${DIR}

FROM scratch
COPY --from=rocky9 /package/*.iso /
