# Note: This dropin only works with kubeadm and kubelet v1.11+
[Service]
Environment="KUBELET_KUBECONFIG_ARGS=--bootstrap-kubeconfig=/etc/kubernetes/bootstrap-kubelet.conf --kubeconfig=/etc/kubernetes/kubelet.conf"
Environment="KUBELET_CONFIG_ARGS=--config=/var/lib/kubelet/config.yaml"
# This is a file that "kubeadm init" and "kubeadm join" generate at runtime, populating the KUBELET_KUBEADM_ARGS variable dynamically
EnvironmentFile=-/var/lib/kubelet/kubeadm-flags.env
# This is a file that the user can use for overrides of the kubelet args as a last resort. Preferably, the user should use
# the .NodeRegistration.KubeletExtraArgs object in the configuration files instead. KUBELET_EXTRA_ARGS should be sourced from this file.
EnvironmentFile=-/etc/default/kubelet
{{- $internalIPv4 := .internal_ipv4 | default "" }}
{{- $internalIPv6 := .internal_ipv6 | default "" }}
{{/* A node is dual-stack when both "internal_ipv4" and "internal_ipv6" are
     defined, and the cluster is dual-stack when "cni.pod_cidr" lists both
     families. kubelet publishes every entry of "--node-ip" as a NodeInternalIP,
     so a family is added only when the node owns the address AND the cluster
     routes that family; advertising a family the cluster does not use makes the
     node report an address that no route covers.
     See https://kubernetes.io/docs/concepts/services-networking/dual-stack/ */}}
{{- $podCIDRs := .cni.pod_cidr | splitList "," }}
{{- $nodeIP := list }}
{{- if and (eq ($podCIDRs | first | ipFamily) "IPv4") ($internalIPv4 | empty | not) }}
    {{- $nodeIP = append $nodeIP $internalIPv4 }}
{{- end }}
{{- if and (eq ($podCIDRs | last | ipFamily) "IPv6") ($internalIPv6 | empty | not) }}
    {{- $nodeIP = append $nodeIP $internalIPv6 }}
{{- end }}
{{- if $nodeIP }}
Environment="KUBELET_EXTRA_ARGS=--node-ip={{ $nodeIP | join "," }} --hostname-override={{ .hostname }}"
{{- else }}
Environment="KUBELET_EXTRA_ARGS=--hostname-override={{ .hostname }}"
{{- end }}
ExecStart=
ExecStart=/usr/local/bin/kubelet $KUBELET_KUBECONFIG_ARGS $KUBELET_CONFIG_ARGS $KUBELET_KUBEADM_ARGS $KUBELET_EXTRA_ARGS
